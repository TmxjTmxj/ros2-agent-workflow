    <!-- ===== 医院服务机器人 AMR ===== -->
    <include>
      <uri>model://hospital_amr</uri>
      <name>hospital_amr</name>
      <pose>12.0 8.0 0 0 0 0</pose>
    </include>

    <!-- ===== 航拍监控相机 ===== -->
    <model name="top_camera">
      <static>1</static>
      <pose>12 9 14 0 0 0</pose>
      <link name="link">
        <sensor name="top_camera_sensor" type="camera">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <!-- Lightweight overview stream for a complete recorded mission. -->
          <update_rate>1</update_rate>
          <topic>top_camera/image_raw</topic>
          <camera name="top_cam">
            <horizontal_fov>1.5</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <!-- Gazebo camera optical axis is local +X; pitch it toward world -Z. -->
          <pose>0 0 0 0 1.5707963267948966 0</pose>
        </sensor>
      </link>
    </model>
</world>
</sdf>
